{
  "manifest_version": 2,
  "name": "Copy Attachment Path",
  "version": "1.0.0",
  "description": "Adds a context menu option to copy the path of an attachment in Zotero.",
  "homepage_url": "https://github.com/example/copy-path-plugin",
  "applications": {
    "zotero": {
      "id": "copy-path-plugin@example.com",
      "strict_min_version": "6.999",
      "strict_max_version": "11.0.*",
      "update_url": "https://raw.githubusercontent.com/example/copy-path-plugin/main/update.json"
    }
  }
}
